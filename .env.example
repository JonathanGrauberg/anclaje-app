# Copiá este archivo a .env y completá los valores.

# Postgres (docker compose o `npm run db:up`, ambos en el puerto 5433)
#   Docker:      postgresql://sentir:sentir@localhost:5433/sentir
#   db:up local: postgresql://sentir@localhost:5433/sentir
DATABASE_URL="postgresql://sentir:sentir@localhost:5433/sentir"
# En producción con pooler (Neon, Supabase): DATABASE_URL es la URL con pooler (la usa la app) y
# DIRECT_DATABASE_URL la directa (la usan migraciones, seed y `crear:usuario`). En local, no hace falta.
# DIRECT_DATABASE_URL=""
# Usuarios demo en el seed: por defecto solo si la base es localhost. "true" fuerza, "false" evita.
# SEED_DEMO=""

# Better Auth
BETTER_AUTH_SECRET="generá-uno-con-npm-run-gen:key"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cifrado a nivel aplicación (AES-256-GCM). Formato: "versión:clave_base64[,versión:clave_base64]"
# Para rotar: agregá una clave nueva y cambiá ENCRYPTION_KEY_VERSION. No borres las viejas.
ENCRYPTION_KEYS="1:generá-una-con-npm-run-gen:key"
ENCRYPTION_KEY_VERSION="1"

# Archivos (biblioteca y resultados externos): "local" (carpeta, para dev) o "s3" (S3, R2, MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
# Con STORAGE_DRIVER="s3" (bucket PRIVADO). Para R2: S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Emails de la cuenta (recuperar contraseña, link para entrar). Sin SMTP_URL se imprimen en la
# consola del servidor. Resend tiene plan gratis (3.000/mes): verificá tu dominio y usá
#   SMTP_URL="smtps://resend:<API_KEY>@smtp.resend.com:465"
# SMTP_URL=""
# EMAIL_FROM="Sentir <soporte@tu-dominio>"

# Avisos push y resumen por email a la profesional: apagados por ahora. "true" para prenderlos
# (además hacen falta las claves VAPID, CRON_SECRET y un cron externo).
# NEXT_PUBLIC_NOTIFICATIONS="true"

# Web Push (avisos). Generalas con `npm run gen:vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@tu-dominio"

# Tareas programadas (/api/cron/recordatorios y /api/cron/resumen). Generalo con `npm run gen:key`.
CRON_SECRET=""
