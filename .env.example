# Copiá este archivo a .env y completá los valores.

# Postgres (docker compose o `npm run db:up`, ambos en el puerto 5433)
#   Docker:      postgresql://sentir:sentir@localhost:5433/sentir
#   db:up local: postgresql://sentir@localhost:5433/sentir
DATABASE_URL="postgresql://sentir:sentir@localhost:5433/sentir"

# Better Auth
BETTER_AUTH_SECRET="generá-uno-con-npm-run-gen:key"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cifrado a nivel aplicación (AES-256-GCM). Formato: "versión:clave_base64[,versión:clave_base64]"
# Para rotar: agregá una clave nueva y cambiá ENCRYPTION_KEY_VERSION. No borres las viejas.
ENCRYPTION_KEYS="1:generá-una-con-npm-run-gen:key"
ENCRYPTION_KEY_VERSION="1"

# Archivos (biblioteca y resultados externos). Por ahora solo "local"; S3/R2 llega en la fase 4.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
